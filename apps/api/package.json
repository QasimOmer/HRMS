{
  "name": "@hrms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @hrms/shared && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --enable-source-maps dist/db/migrate.js",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env --enable-source-maps dist/db/migrate.js --deploy",
    "db:seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/db/seed.js",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "platform:admin": "node --env-file-if-exists=../../.env --enable-source-maps dist/db/create-platform-admin.js"
  },
  "dependencies": {
    "@hrms/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsc-watch": "^7.1.0",
    "typescript": "~5.9.0"
  }
}
