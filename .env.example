# Copy to .env (or run: node scripts/setup-env.mjs to generate secrets automatically)
NODE_ENV=development

# --- Database ---
PG_PORT=5433
PG_SUPERUSER_PASSWORD=change-me
PG_APP_PASSWORD=change-me
# Owner connection – used only for migrations
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5433/hrms
# Application connection – non-owner role, Row-Level Security enforced
DATABASE_URL=postgres://hrms_app:change-me@localhost:5433/hrms

# --- API ---
API_PORT=4000
APP_URL=http://localhost:3000
JWT_SECRET=change-me
DATA_HMAC_SECRET=change-me
# Optional (SEC-05): 32-byte base64 key for encrypting CNIC, salary and complaints at rest.
# If empty it is derived from DATA_HMAC_SECRET. Never change either once data exists.
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Uploaded files: "disk" (under STORAGE_DIR) or "db" (inside Postgres; the default on Vercel).
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Daily attendance and billing jobs. Set to false on extra API instances so they only run once.
ENABLE_SCHEDULER=true

# --- Email (leave SMTP_URL empty in dev: emails are printed to the API log) ---
SMTP_URL=
MAIL_FROM="HRMS <no-reply@hrms.local>"

# --- Web ---
API_INTERNAL_URL=http://localhost:4000

# --- Branding (shown in the web app; rebuild the web app after changing) ---
NEXT_PUBLIC_APP_NAME=HRMS
NEXT_PUBLIC_APP_TAGLINE="People, payroll and attendance in one place."
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Platform owner (the SaaS operator) ---
# There is no public sign-up. Create the first owner once with:
#   npm run platform:admin -- --email you@example.com --name "Your Name"
# The values below are used by that command (and by the local test scripts) when no flags are given.
PLATFORM_ADMIN_EMAIL=owner@hrms.local
PLATFORM_ADMIN_NAME="Platform Owner"
PLATFORM_ADMIN_PASSWORD=change-me
